name: Update Pixi Lock File

permissions:
  contents: write
  pull-requests: write

on:
  workflow_dispatch:
  schedule:
    - cron: "0 6 * * 0"  # Sundays at 6 AM UTC

jobs:
  pixi-update:
    name: Update pixi.lock
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up pixi
        uses: prefix-dev/setup-pixi@v0.9.5
        with:
          pixi-version: v0.69.0
          run-install: false

      - name: Update lock file
        run: |
          set -o pipefail
          pixi update --json | pixi exec pixi-diff-to-markdown >> diff.md

      - name: Create pull request
        uses: peter-evans/create-pull-request@v7
        with:
          token: ${{ secrets.RELEASE_PAT }}
          commit-message: "chore(deps): update pixi lockfile"
          title: "chore(deps): update pixi lockfile"
          body-path: diff.md
          branch: update-pixi-lock
          base: main
          labels: pixi,dependencies
          delete-branch: true
          add-paths: pixi.lock
