# =============================================================================
# idp-app — Environment Variables Example
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Integrated Developer Portal"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=development  # development | staging | production

# API
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_USER=idp_user
DB_PASSWORD=changeme           # required — must be set
DB_HOST=localhost
DB_PORT=5432
DB_NAME=idp_db
# Alternatively, override the entire URL directly:
# DATABASE_URL=postgresql://idp_user:changeme@localhost:5432/idp_db

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# OAuth2 — GitHub
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/api/v1/auth/github/callback
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ---------------------------------------------------------------------------
# OAuth2 — Google
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
# Required scopes: openid email profile
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Used by the backend to redirect the browser after OAuth flows complete
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# ---------------------------------------------------------------------------
# GitHub Content Repository (library sync)
# Create a fine-grained PAT (or classic token with repo:read) at
# https://github.com/settings/tokens and set it here.
# GITHUB_CONTENT_OWNER and GITHUB_CONTENT_REPO identify the repo that holds
# the /skills/{slug}/SKILL.md and /prompts/{slug}.md content files.
# ---------------------------------------------------------------------------
GITHUB_CONTENT_TOKEN=your-github-content-pat
GITHUB_CONTENT_OWNER=your-org-or-username
GITHUB_CONTENT_REPO=your-content-repo
GITHUB_CONTENT_BRANCH=main

# ---------------------------------------------------------------------------
# Library Cache
# How often the library.sync_content Celery Beat task fires (seconds).
# Default: 900 (15 minutes).
# ---------------------------------------------------------------------------
LIBRARY_CACHE_TTL=900
