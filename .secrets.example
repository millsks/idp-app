# .secrets.example — Copy to .secrets and fill in values for local act runs.
# .secrets is listed in .gitignore and must NEVER be committed.
#
# Usage: cp .secrets.example .secrets

# GitHub App credentials (millsks-release-helper)
APP_ID=your_github_app_id_here
APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your_private_key_here
-----END RSA PRIVATE KEY-----"

# Personal Access Token (used by maintenance workflow for PRs)
RELEASE_PAT=ghp_your_pat_here

# Codecov upload token (optional — public repos don't need this)
CODECOV_TOKEN=your_codecov_token_here
