# .env.act — Environment variables injected into act (local workflow) runs.
# Safe to commit — no secrets here; actual secrets go in .secrets.

GITHUB_TOKEN=dummy-token-for-local-act-runs
POSTGRES_DB=idp_test_db
POSTGRES_USER=idp_test_user
POSTGRES_PASSWORD=idp_test_password
SECRET_KEY=local-act-test-secret-key
